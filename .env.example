# MindBridge 환경변수 템플릿
# 사용: 이 파일을 .env.local 로 복사하고 실제 값으로 채울 것
# 주의: .env.local 은 절대 commit 금지 (.gitignore 적용됨)
# 자세한 가입·발급 방법은 docs/setup.md 참조

# === Week 0 즉시 필요 ===

# Neon Postgres (docs/setup.md §1.3)
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host/dbname"

# Anthropic Claude API (docs/setup.md §1.4)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# NextAuth (Week 1 Day 2 활성화, 키는 Week 0 에 미리 생성)
# 생성: openssl rand -base64 32   또는 PowerShell 등가 명령
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# 컬럼 암호화 (Week 3 Day 18 활성화, 키는 Week 0 에 미리 생성)
# 변경 금지 — 기존 데이터 복호화 불가
ENCRYPTION_KEY=""
ENCRYPTION_KEY_VERSION="1"

# 익명화 salt (BLAKE2b for User.anonymizedId)
ANONYMIZATION_SALT=""

# === Deferred (Day 7+) ===

# Sentry (Day 7+)
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# Resend (Day 12+, Sandbox 모드)
# RESEND_API_KEY=""

# Pusher (Day 15+)
# PUSHER_APP_ID=""
# PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER="ap3"
# NEXT_PUBLIC_PUSHER_KEY=""
# NEXT_PUBLIC_PUSHER_CLUSTER="ap3"

# === 기타 ===

NODE_ENV="development"

# 데모 환경 배너 (앱 상단 노란 띠)
NEXT_PUBLIC_DEMO_BANNER="true"

# Rate limit 토글 (V1 기본 활성)
RATE_LIMIT_ENABLED="true"

# 로그 레벨 (debug | info | warn | error)
LOG_LEVEL="debug"
